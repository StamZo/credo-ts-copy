{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "jest", "express"],
    "outDir": "./dist",
    "baseUrl": "./src",
    "paths": {
      "@credo-ts/indy-besu-vdr": ["../../packages/indy-besu-vdr/src"],
      "@credo-ts/indy-besu-vdr/*": ["../../packages/indy-besu-vdr/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/indy-besu-vdr/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
